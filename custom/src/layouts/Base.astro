---
import { getCollection } from 'astro:content';
import { docUrl } from '../lib/helpers';
import '../styles/global.css';

const entries = await getCollection('docs');
const path = Astro.url.pathname;

const activeTopic = (() => {
  const m = path.match(/^\/topics\/([^/]+)\/?$/);
  if (m) return decodeURIComponent(m[1]);
  return entries.find((e) => docUrl(e.id) === path)?.data.topic;
})();

const projectMap = new Map<string, { count: number; pending: number; topics: Map<string, { count: number; pending: number }> }>();
for (const e of entries) {
  let p = projectMap.get(e.data.project);
  if (!p) {
    p = { count: 0, pending: 0, topics: new Map() };
    projectMap.set(e.data.project, p);
  }
  p.count++;
  if (e.data.status === 'pending') p.pending++;
  let t = p.topics.get(e.data.topic);
  if (!t) {
    t = { count: 0, pending: 0 };
    p.topics.set(e.data.topic, t);
  }
  t.count++;
  if (e.data.status === 'pending') t.pending++;
}
const projects = [...projectMap.entries()]
  .map(([name, p]) => ({
    name,
    count: p.count,
    pending: p.pending,
    topics: [...p.topics.entries()]
      .map(([t, v]) => ({ name: t, count: v.count, pending: v.pending }))
      .sort((a, b) => a.name.localeCompare(b.name, 'zh')),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const totalPending = entries.filter((e) => e.data.status === 'pending').length;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>文枢 · 项目文档库</title>
    <meta name="description" content="文档脉络 · 版本有迹 · 人机共读" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/MapleMono-CN-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/"><img class="brand-logo" src="/logo.svg" alt="" width="22" height="22" />文枢</a>
      <span class="brand-sub">项目文档库</span>
      <div class="search-wrap">
        <input id="q" type="search" placeholder="全文搜索（Ctrl+K）" autocomplete="off" />
        <div id="results" class="search-results" hidden></div>
      </div>
      <a class="pending-chip" href="/pending/" title={`待办 ${totalPending} 项`} aria-label={`待办 ${totalPending} 项`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="17" rx="2.5" />
          <path d="M8 2.5v3M16 2.5v3M8 12l2.5 2.5L16 9" />
        </svg>
        {totalPending > 0 && <span class="pending-badge">{totalPending}</span>}
      </a>
      <button id="theme-toggle" title="切换明暗主题">◐</button>
    </header>
    <div class="shell">
      <aside class="sidebar">
        <nav>
          <a class={`nav-item ${path === '/' ? 'active' : ''}`} href="/">总览</a>
          <a class={`nav-item ${path.startsWith('/pending') ? 'active' : ''}`} href="/pending/">
            待办看板 <span class="badge-count warning">{totalPending}</span>
          </a>
          <a class="nav-item" href="/swagger/">接口交互</a>
        </nav>
        {projects.map((p) => {
          const isOpen = activeTopic ? p.topics.some((t) => t.name === activeTopic) : false;
          return (
            <div class={`side-project ${isOpen ? 'open' : ''}`} data-name={p.name}>
              <button class="side-project-name" type="button" aria-expanded={isOpen ? 'true' : 'false'}>
                <span class="side-project-label">{p.name}</span>
                {p.pending > 0 && <span class="badge-count warning">{p.pending}</span>}
                <svg class="side-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </button>
              <div class="side-topics">
                {p.topics.map((t) => (
                  <a
                    class={`side-topic ${t.name === activeTopic ? 'active' : ''}`}
                    href={`/topics/${encodeURIComponent(t.name)}/`}
                  >
                    <span>{t.name}</span>
                    {t.pending > 0 ? <span class="dot pending" title="有未完成事项" /> : <span class="count">{t.count}</span>}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
        <div class="sidebar-footer">
          <a class="icon-btn" href="/logout" title="退出登录" aria-label="退出登录">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <path d="M16 17l5-5-5-5" />
              <path d="M21 12H9" />
            </svg>
          </a>
        </div>
      </aside>
      <main class="content"><slot /></main>
    </div>
    <script is:inline>
      const html = document.documentElement;
      const saved = localStorage.getItem('ws-theme');
      if (saved) html.dataset.theme = saved;
      if (new URLSearchParams(location.search).get('share') === '1') html.classList.add('shared');
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        html.dataset.theme = html.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('ws-theme', html.dataset.theme);
      });

      const sidebar = document.querySelector('.sidebar');
      if (sidebar) {
        const SB_KEY = 'ws-sidebar-scroll';
        const PROJ_KEY = 'ws-side-projects';

        let openProjects = new Set();
        try { openProjects = new Set(JSON.parse(sessionStorage.getItem(PROJ_KEY) || '[]')); } catch {}
        sidebar.querySelectorAll('.side-project').forEach((group) => {
          const name = group.dataset.name;
          const btn = group.querySelector('.side-project-name');
          if (openProjects.has(name)) group.classList.add('open');
          const syncAria = () => btn.setAttribute('aria-expanded', group.classList.contains('open') ? 'true' : 'false');
          syncAria();
          btn.addEventListener('click', () => {
            const open = group.classList.toggle('open');
            if (open) openProjects.add(name); else openProjects.delete(name);
            try { sessionStorage.setItem(PROJ_KEY, JSON.stringify([...openProjects])); } catch {}
            syncAria();
          });
        });

        try {
          const y = sessionStorage.getItem(SB_KEY);
          if (y !== null) sidebar.scrollTop = Number(y) || 0;
        } catch {}
        let sbRaf = 0;
        sidebar.addEventListener('scroll', () => {
          if (sbRaf) return;
          sbRaf = requestAnimationFrame(() => {
            sbRaf = 0;
            try { sessionStorage.setItem(SB_KEY, String(sidebar.scrollTop)); } catch {}
          });
        }, { passive: true });
        window.addEventListener('pagehide', () => {
          try { sessionStorage.setItem(SB_KEY, String(sidebar.scrollTop)); } catch {}
        });

        const active = sidebar.querySelector('.side-topic.active');
        if (active && sidebar.clientHeight) {
          const sRect = sidebar.getBoundingClientRect();
          const aRect = active.getBoundingClientRect();
          const relTop = aRect.top - sRect.top;
          if (relTop < 0 || relTop + aRect.height > sidebar.clientHeight) {
            sidebar.scrollTop += relTop - (sidebar.clientHeight - aRect.height) / 2;
          }
        }
      }

      let index = null;
      let pf = null;
      const input = document.getElementById('q');
      const box = document.getElementById('results');
      const statusText = { pending: '待处理', executed: '已执行', implemented: '已实现', draft: '草稿', final: '定稿', accepted: '已采纳', archived: '归档' };
      function debounce(fn, ms) {
        let t;
        return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
      }
      async function ensurePagefind() {
        if (pf) return pf;
        try {
          pf = await import('/pagefind/pagefind.js');
          return pf;
        } catch {
          pf = null;
          return null;
        }
      }
      async function ensureIndex() {
        if (!index) index = await (await fetch('/search-index.json')).json();
        return index;
      }
      function renderHits(hits) {
        const query = input ? input.value.trim() : '';
        const withQ = (u) => u + (u.includes('?') ? '&' : '?') + 'q=' + encodeURIComponent(query);
        box.innerHTML = hits.length
          ? hits.map((h) => `<a href="${withQ(h.url)}"><b>${h.title}</b><span>${h.meta}</span>${h.excerpt ? `<div class="excerpt">${h.excerpt}</div>` : ''}</a>`).join('')
          : '<div class="empty">无结果</div>';
        box.hidden = false;
      }
      input?.addEventListener('input', debounce(async () => {
        const q = input.value.trim();
        if (!q) { box.hidden = true; box.innerHTML = ''; return; }
        const engine = await ensurePagefind();
        if (engine) {
          const search = await engine.search(q);
          const top = search.results.slice(0, 8);
          const data = await Promise.all(top.map((r) => r.data()));
          renderHits(data.map((d) => ({
            url: d.url,
            title: (d.meta && d.meta.title) || q,
            meta: [d.meta && d.meta.topic, d.meta && d.meta.type && d.meta.type.toUpperCase(), d.meta && statusText[d.meta.status]].filter(Boolean).join(' · '),
            excerpt: d.excerpt || '',
          })));
          return;
        }
        const data = await ensureIndex();
        const hits = data
          .filter((d) => (d.title + ' ' + d.topic + ' ' + (d.summary || '') + ' ' + d.project + ' ' + d.type).toLowerCase().includes(q.toLowerCase()))
          .slice(0, 10);
        renderHits(hits.map((h) => ({
          url: h.url,
          title: h.title,
          meta: `${h.project} · ${h.topic} · ${statusText[h.status] || h.status}`,
          excerpt: '',
        })));
      }, 160));
      input?.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        const first = box.querySelector('a');
        if (first) { e.preventDefault(); location.href = first.getAttribute('href'); }
      });
      document.addEventListener('click', (e) => {
        if (box && !e.target.closest('.search-wrap')) box.hidden = true;
      });
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input?.focus(); }
      });

      /* 搜索词定位与高亮（带上一处/下一处导航） */
      (function () {
        const params = new URLSearchParams(location.search);
        const q = (params.get('q') || '').trim();
        const container = document.querySelector('[data-pagefind-body]');
        if (!q || !container) return;

        const candidates = [q, ...q.split(/\s+/).filter(Boolean)];
        let marks = [];
        for (const term of candidates) {
          const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
              if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
              const p = node.parentElement;
              if (!p || p.closest('mark.search-hit')) return NodeFilter.FILTER_REJECT;
              const tag = p.tagName;
              if (tag === 'SCRIPT' || tag === 'STYLE') return NodeFilter.FILTER_REJECT;
              return NodeFilter.FILTER_ACCEPT;
            },
          });
          const nodes = [];
          while (walker.nextNode()) nodes.push(walker.currentNode);
          for (const node of nodes) {
            const text = node.nodeValue;
            const lowerText = text.toLowerCase();
            const lowerTerm = term.toLowerCase();
            let idx = lowerText.indexOf(lowerTerm);
            if (idx === -1) continue;
            const frag = document.createDocumentFragment();
            let last = 0;
            while (idx !== -1) {
              if (idx > last) frag.appendChild(document.createTextNode(text.slice(last, idx)));
              const mark = document.createElement('mark');
              mark.className = 'search-hit';
              mark.textContent = text.slice(idx, idx + term.length);
              frag.appendChild(mark);
              last = idx + term.length;
              idx = lowerText.indexOf(lowerTerm, last);
            }
            if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
            node.parentNode.replaceChild(frag, node);
          }
          marks = [...container.querySelectorAll('mark.search-hit')];
          if (marks.length) break;
        }
        if (!marks.length) return;

        let cur = 0;
        const nav = document.createElement('div');
        nav.className = 'search-nav';
        nav.innerHTML = '<span class="q">「' + q + '」</span><span class="count"></span>' +
          '<button data-dir="-1" title="上一处">↑</button><button data-dir="1" title="下一处">↓</button><button data-close="1" title="关闭高亮">×</button>';
        document.body.appendChild(nav);
        const countEl = nav.querySelector('.count');
        function go(i) {
          cur = (i + marks.length) % marks.length;
          marks.forEach((m, k) => m.classList.toggle('current', k === cur));
          const rect = marks[cur].getBoundingClientRect();
          window.scrollTo({ top: rect.top + window.scrollY - 96, behavior: 'smooth' });
          countEl.textContent = (cur + 1) + ' / ' + marks.length;
        }
        nav.addEventListener('click', (e) => {
          const t = e.target;
          if (t.dataset && t.dataset.close) {
            nav.remove();
            marks.forEach((m) => m.classList.remove('current'));
            return;
          }
          if (t.dataset && t.dataset.dir) go(cur + Number(t.dataset.dir));
        });
        go(0);
      })();

      /* 复制按钮（data-copy） */
      document.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('[data-copy]') : null;
        if (!btn) return;
        const text = btn.getAttribute('data-copy') || '';
        const label = btn.getAttribute('data-label') || btn.textContent;
        const done = () => {
          btn.textContent = '已复制 ✓';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = label; btn.classList.remove('copied'); }, 1600);
        };
        const fallback = () => {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '-1000px';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); done(); } catch (_) {}
          ta.remove();
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(done).catch(fallback);
        } else {
          fallback();
        }
      });

      /* 代码块复制（右上角图标） */
      (() => {
        const blocks = document.querySelectorAll('.prose pre');
        if (!blocks.length) return;
        const ICON_COPY = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
        const ICON_DONE = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>';
        const copyText = (text, done) => {
          const fallback = () => {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.top = '-1000px';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); done(); } catch (_) {}
            ta.remove();
          };
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done).catch(fallback);
          } else {
            fallback();
          }
        };
        blocks.forEach((pre) => {
          const code = pre.querySelector('code');
          if (!code || !code.textContent.trim()) return;
          const wrap = document.createElement('div');
          wrap.className = 'code-wrap';
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(pre);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.title = '复制代码';
          btn.setAttribute('aria-label', '复制代码');
          btn.setAttribute('data-pagefind-ignore', '');
          btn.innerHTML = ICON_COPY;
          btn.addEventListener('click', () => {
            copyText(code.innerText, () => {
              btn.innerHTML = ICON_DONE;
              btn.classList.add('copied');
              setTimeout(() => {
                btn.innerHTML = ICON_COPY;
                btn.classList.remove('copied');
              }, 1500);
            });
          });
          wrap.appendChild(btn);
        });
      })();

      /* 仅文档正文可复制，界面其他区域禁用 */
      document.addEventListener('copy', (e) => {
        const sel = document.getSelection();
        if (!sel || sel.isCollapsed) return;
        const node = sel.anchorNode;
        const el = node && (node.nodeType === 1 ? node : node.parentElement);
        if (el && (el.closest('.prose') || el.closest('input, textarea'))) return;
        e.preventDefault();
      });
    </script>
  </body>
</html>
