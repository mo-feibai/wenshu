---
import { getCollection } from 'astro:content';
import { docUrl } from '../lib/helpers';
import '../styles/global.css';

const entries = await getCollection('docs');
const path = Astro.url.pathname;

const activeTopic = (() => {
  const m = path.match(/^\/topics\/([^/]+)\/?$/);
  if (m) return decodeURIComponent(m[1]);
  return entries.find((e) => docUrl(e.id) === path)?.data.topic;
})();

const projectMap = new Map<string, { count: number; pending: number; topics: Map<string, { count: number; pending: number }> }>();
for (const e of entries) {
  let p = projectMap.get(e.data.project);
  if (!p) {
    p = { count: 0, pending: 0, topics: new Map() };
    projectMap.set(e.data.project, p);
  }
  p.count++;
  if (e.data.status === 'pending') p.pending++;
  let t = p.topics.get(e.data.topic);
  if (!t) {
    t = { count: 0, pending: 0 };
    p.topics.set(e.data.topic, t);
  }
  t.count++;
  if (e.data.status === 'pending') t.pending++;
}
const projects = [...projectMap.entries()]
  .map(([name, p]) => ({
    name,
    count: p.count,
    pending: p.pending,
    topics: [...p.topics.entries()]
      .map(([t, v]) => ({ name: t, count: v.count, pending: v.pending }))
      .sort((a, b) => a.name.localeCompare(b.name, 'zh')),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const totalPending = entries.filter((e) => e.data.status === 'pending').length;
---

<!doctype html>
<html lang="zh-CN" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>文枢 · 项目文档库</title>
    <meta name="description" content="文档脉络 · 版本有迹 · 人机共读" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/MapleMono-CN-Regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/"><img class="brand-logo" src="/logo.svg" alt="" width="22" height="22" />文枢</a>
      <span class="brand-sub">项目文档库</span>
      <div class="search-wrap">
        <input id="q" type="search" placeholder="全文搜索（Ctrl+K）" autocomplete="off" />
        <div id="results" class="search-results" hidden></div>
      </div>
      <a class="pending-chip" href="/pending/" title={`待办 ${totalPending} 项`} aria-label={`待办 ${totalPending} 项`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="4" width="18" height="17" rx="2.5" />
          <path d="M8 2.5v3M16 2.5v3M8 12l2.5 2.5L16 9" />
        </svg>
        {totalPending > 0 && <span class="pending-badge">{totalPending}</span>}
      </a>
      <button id="theme-toggle" title="切换明暗主题">◐</button>
    </header>
    <div class="shell">
      <aside class="sidebar">
        <nav>
          <a class={`nav-item ${path === '/' ? 'active' : ''}`} href="/">总览</a>
          <a class={`nav-item ${path.startsWith('/pending') ? 'active' : ''}`} href="/pending/">
            待办看板 <span class="badge-count warning">{totalPending}</span>
          </a>
          <a class={`nav-item ${path.startsWith('/review') ? 'active' : ''}`} href="/review/">淘汰审阅</a>
          <a class={`nav-item ${path.startsWith('/shares') ? 'active' : ''}`} href="/shares/">分享管理</a>
          <a class="nav-item" href="/swagger/">接口交互</a>
        </nav>
        {projects.map((p) => {
          const isOpen = activeTopic ? p.topics.some((t) => t.name === activeTopic) : false;
          return (
            <div class={`side-project ${isOpen ? 'open' : ''}`} data-name={p.name}>
              <button class="side-project-name" type="button" aria-expanded={isOpen ? 'true' : 'false'}>
                <span class="side-project-label">{p.name}</span>
                {p.pending > 0 && <span class="badge-count warning">{p.pending}</span>}
                <svg class="side-caret" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M9 6l6 6-6 6" />
                </svg>
              </button>
              <div class="side-topics">
                <a class="side-topic side-project-home" href={`/projects/${encodeURIComponent(p.name)}/`}>
                  <span>项目总览</span>
                  <span class="count">{p.count}</span>
                </a>
                {p.topics.map((t) => (
                  <a
                    class={`side-topic ${t.name === activeTopic ? 'active' : ''}`}
                    href={`/topics/${encodeURIComponent(t.name)}/`}
                  >
                    <span>{t.name}</span>
                    {t.pending > 0 ? <span class="dot pending" title="有未完成事项" /> : <span class="count">{t.count}</span>}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
        <div class="sidebar-footer">
          <a class="icon-btn" href="/logout" title="退出登录" aria-label="退出登录">
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <path d="M16 17l5-5-5-5" />
              <path d="M21 12H9" />
            </svg>
          </a>
        </div>
      </aside>
      <main class="content"><slot /></main>
    </div>
    <script is:inline>
      const html = document.documentElement;
      const saved = localStorage.getItem('ws-theme');
      if (saved) html.dataset.theme = saved;
      if (new URLSearchParams(location.search).get('share') === '1') html.classList.add('shared');
      const isShareView = new URLSearchParams(location.search).get('share') === '1';

      /* 模块分享模式：向服务端确认当前访客的分享作用域，再据此裁剪导航与搜索 */
      function moduleTopicOf() {
        const m = location.pathname.match(/^\/topics\/([^/]+)\/?$/);
        return m ? decodeURIComponent(m[1]) : '';
      }
      function moduleProjectOf() {
        const m = location.pathname.match(/^\/projects\/([^/]+)\/?$/);
        return m ? decodeURIComponent(m[1]) : '';
      }
      function decodePath(p) {
        try { return decodeURIComponent(p); } catch { return p; }
      }
      async function bootShareScope() {
        if (!isShareView) return;
        const qs = new URLSearchParams({ path: location.pathname });
        const topic = moduleTopicOf();
        const proj = moduleProjectOf();
        if (topic) qs.set('topic', topic);
        if (proj) {
          qs.set('project', proj);
          const tp = new URLSearchParams(location.search).get('type');
          if (tp) qs.set('type', tp);
        }
        qs.set('path', location.pathname);
        let ctx = null;
        try {
          const res = await fetch('/api/share/ctx?' + qs);
          if (res.ok) ctx = await res.json();
        } catch { ctx = null; }
        if (!ctx) return;
        window.__wsShareScope = { topic: ctx.topic || '', project: ctx.project || '' };
        if (ctx.scope !== 'module' && ctx.scope !== 'topic' && ctx.scope !== 'project') return;
        /* 模块模式：保留侧栏与搜索框（内容换成模块清单与模块内搜索） */
        html.classList.add('module-mode');

        /* 侧栏：隐藏全站导航与项目树，换成本模块文档清单（站外标题一个都不泄露） */
        const sb = document.querySelector('.sidebar');
        if (sb) {
          sb.querySelectorAll('nav, .side-project').forEach((n) => (n.style.display = 'none'));
          const head = document.createElement('div');
          head.className = 'side-module-head';
          head.innerHTML = '<span class="side-module-title"></span><span class="side-module-count"></span>';
          head.querySelector('.side-module-title').textContent = ctx.topic || ctx.project;
          head.querySelector('.side-module-count').textContent = ctx.docs.length + ' 篇';
          const list = document.createElement('div');
          list.className = 'side-topics module';
          const here = decodePath(location.pathname).replace(/\/$/, '');
          for (const d of ctx.docs) {
            const a = document.createElement('a');
            a.className = 'side-topic' + (decodePath(d.url).replace(/\/$/, '') === here ? ' active' : '');
            a.href = d.url + '?share=1';
            const s1 = document.createElement('span');
            s1.textContent = d.title;
            const s2 = document.createElement('span');
            s2.className = 'count';
            s2.textContent = (d.type || '').toUpperCase();
            a.append(s1, s2);
            list.appendChild(a);
          }
          sb.insertBefore(list, sb.firstChild);
          sb.insertBefore(head, sb.firstChild);
          const active = sb.querySelector('.side-topic.active');
          if (active && sb.clientHeight) {
            const rel = active.getBoundingClientRect().top - sb.getBoundingClientRect().top;
            if (rel < 0 || rel + active.offsetHeight > sb.clientHeight) sb.scrollTop += rel - 16;
          }
        }
        /* 越界入口处理：访客点这些链接只会跳登录页（看起来像「侧边栏消失了」）。
           brand 改为指向本模块落地页；面包屑中不在分享范围内的段落降级为纯文本。
           注意：模块模式在文档页上无法从 pathname 推断项目/主题（正则只匹配
           /projects/<name>/ 与 /topics/<name>/），必须用服务端 ctx 返回的 scope。 */
        const shareTopic = ctx.topic || topic;
        const shareProject = ctx.project || proj;
        const landing = shareTopic
          ? '/topics/' + encodeURIComponent(shareTopic) + '/?share=1'
          : (shareProject ? '/projects/' + encodeURIComponent(shareProject) + '/?share=1'
            + (ctx.type ? '&type=' + encodeURIComponent(ctx.type) : '') : '');
        if (landing) {
          const brand = document.querySelector('a.brand');
          if (brand) brand.setAttribute('href', landing);
        }
        document.querySelectorAll('.breadcrumb a').forEach((a) => {
          const t = decodePath(a.getAttribute('href') || '').split('?')[0].replace(/\/$/, '');
          const inScope = (shareTopic && t === '/topics/' + shareTopic)
            || (shareProject && t === '/projects/' + shareProject);
          if (!inScope) a.replaceWith(document.createTextNode(a.textContent || ''));
        });
        /* 相关文档：只保留指向模块内文档的链接 */
        const allowed = new Set(ctx.docs.map((d) => decodePath(d.url).replace(/\/$/, '')));
        document.querySelectorAll('.related-block .meta-links a').forEach((a) => {
          const href = decodePath(a.getAttribute('href') || '').replace(/\/$/, '');
          if (!allowed.has(href)) a.remove();
        });
        document.querySelectorAll('.related-block').forEach((b) => {
          if (!b.querySelector('.meta-links a')) b.remove();
        });
        /* 搜索框提示语改成模块语义 */
        const q = document.getElementById('q');
        if (q) q.placeholder = '在本模块内搜索（Ctrl+K）';

        /* 落地页清理：只保留分享作用域内的文档（主题落地页与项目落地页都必须做，
           否则项目落地页会把历史版本、其它类型的文档也列给访客） */
        if (topic || proj) {
          document.querySelectorAll('.version-chain, .module-share, .type-filter, .project-tools')
            .forEach((n) => n.remove());
          const allowedLanding = new Set(ctx.docs.map((d) => decodePath(d.url).replace(/\/$/, '')));
          let hidden = 0;
          const dropCard = (item) => {
            const a = item.querySelector('a[href]');
            const href = a ? decodePath(a.getAttribute('href') || '').replace(/\/$/, '') : '';
            if (!allowedLanding.has(href)) { item.remove(); hidden++; }
          };
          const tl = document.querySelector('.timeline');
          if (tl) tl.querySelectorAll('.tl-item').forEach(dropCard);
          const pg = document.querySelector('.project-groups');
          if (pg) pg.querySelectorAll('.project-card').forEach(dropCard);
          if (tl && !tl.querySelector('.tl-item')) tl.remove();
          if (pg) {
            pg.querySelectorAll('.type-group').forEach((g) => {
              if (!g.querySelector('.project-card')) g.remove();
            });
            if (!pg.querySelector('.project-card')) pg.remove();
          }
          const hero = document.querySelector('.hero') || document.querySelector('.project-hero');
          const sub0 = hero && hero.querySelector('p');
          if (hero) {
            const scopeName = topic
              ? `主题 · ${topic}`
              : (ctx.type ? `项目 · ${proj} · ${ctx.type}` : `项目 · ${proj}`);
            const txt = `本分享开放 ${ctx.docs.length} 篇当前版文档`
              + (hidden ? `（已隐藏 ${hidden} 篇不在分享范围内的文档）` : '')
              + `　范围：${scopeName}`;
            // 项目页 hero 没有 <p>（只有 .project-stats），需要新建一个说明行
            const sub = sub0 || Object.assign(document.createElement('p'), { className: 'share-scope' });
            if (!sub0) hero.appendChild(sub);
            sub.textContent = txt;
          }
          if (!ctx.docs.length) {
            const p2 = document.createElement('p');
            p2.className = 'share-empty';
            p2.textContent = '本模块暂无可访问的文档。';
            (hero || pg || document.body).appendChild(p2);
          }
        }

        /* 项目落地页：只保留作用域内文档，隐藏历史版本与内部操作入口 */
        if (proj) {
          document.querySelectorAll('.module-share, .project-search, .type-filter').forEach((n) => n.remove());
          const hist = document.querySelector('.project-historical');
          if (hist) hist.remove();
          const allowedProject = new Set(ctx.docs.map((d) => decodePath(d.url).replace(/\/$/, '')));
          document.querySelectorAll('.project-card a[href]').forEach((a) => {
            const href = decodePath(a.getAttribute('href') || '').replace(/\/$/, '');
            if (!allowedProject.has(href)) { const c = a.closest('.project-card'); if (c) c.remove(); }
          });
          document.querySelectorAll('.type-group').forEach((g) => {
            if (!g.querySelector('.project-card')) g.remove();
          });
          const groups = document.querySelector('.project-groups');
          if (groups && !groups.querySelector('.project-card')) {
            groups.innerHTML = '<p class="empty">本模块暂无可访问的文档。</p>';
          }
          const stats = document.querySelector('.project-stats');
          if (stats) stats.innerHTML = `<span>本模块开放 <b>${ctx.docs.length}</b> 篇当前版文档</span>`;
        }
      }
      bootShareScope();
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        html.dataset.theme = html.dataset.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('ws-theme', html.dataset.theme);
      });

      const sidebar = document.querySelector('.sidebar');
      if (sidebar) {
        const SB_KEY = 'ws-sidebar-scroll';
        const PROJ_KEY = 'ws-side-projects';

        let openProjects = new Set();
        try { openProjects = new Set(JSON.parse(sessionStorage.getItem(PROJ_KEY) || '[]')); } catch {}
        sidebar.querySelectorAll('.side-project').forEach((group) => {
          const name = group.dataset.name;
          const btn = group.querySelector('.side-project-name');
          if (openProjects.has(name)) group.classList.add('open');
          const syncAria = () => btn.setAttribute('aria-expanded', group.classList.contains('open') ? 'true' : 'false');
          syncAria();
          btn.addEventListener('click', () => {
            const open = group.classList.toggle('open');
            if (open) openProjects.add(name); else openProjects.delete(name);
            try { sessionStorage.setItem(PROJ_KEY, JSON.stringify([...openProjects])); } catch {}
            syncAria();
          });
        });

        try {
          const y = sessionStorage.getItem(SB_KEY);
          if (y !== null) sidebar.scrollTop = Number(y) || 0;
        } catch {}
        let sbRaf = 0;
        sidebar.addEventListener('scroll', () => {
          if (sbRaf) return;
          sbRaf = requestAnimationFrame(() => {
            sbRaf = 0;
            try { sessionStorage.setItem(SB_KEY, String(sidebar.scrollTop)); } catch {}
          });
        }, { passive: true });
        window.addEventListener('pagehide', () => {
          try { sessionStorage.setItem(SB_KEY, String(sidebar.scrollTop)); } catch {}
        });

        const active = sidebar.querySelector('.side-topic.active');
        if (active && sidebar.clientHeight) {
          const sRect = sidebar.getBoundingClientRect();
          const aRect = active.getBoundingClientRect();
          const relTop = aRect.top - sRect.top;
          if (relTop < 0 || relTop + aRect.height > sidebar.clientHeight) {
            sidebar.scrollTop += relTop - (sidebar.clientHeight - aRect.height) / 2;
          }
        }
      }

      let index = null;
      let pf = null;
      const input = document.getElementById('q');
      const box = document.getElementById('results');
      const statusText = { pending: '待处理', executed: '已执行', implemented: '已实现', draft: '草稿', final: '定稿', accepted: '已采纳', archived: '已归档' };
      function debounce(fn, ms) {
        let t;
        return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
      }
      async function ensurePagefind() {
        if (pf) return pf;
        try {
          pf = await import('/pagefind/pagefind.js');
          return pf;
        } catch {
          pf = null;
          return null;
        }
      }
      async function ensureIndex() {
        if (!index) index = await (await fetch('/search-index.json')).json();
        return index;
      }
      function hlSnippet(snippet, term) {
        const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
        const text = esc(snippet || '');
        const safe = String(term ?? '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return safe ? text.replace(new RegExp(safe.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'gi'), (m) => `<mark class="search-hit">${m}</mark>`) : text;
      }
      function renderHits(hits) {
        const query = input ? input.value.trim() : '';
        const withQ = (u) => u + (u.includes('?') ? '&' : '?') + 'q=' + encodeURIComponent(query);
        box.innerHTML = hits.length
          ? hits.map((h) => `<a href="${withQ(h.url)}"><b>${h.title}</b><span>${h.meta}</span>${h.excerpt ? `<div class="excerpt">${h.excerpt}</div>` : ''}</a>`).join('')
          : '<div class="empty">无结果</div>';
        box.hidden = false;
      }

      /* 模块分享：搜索限定在分享作用域内（服务端接口），不走 Pagefind 全站索引 */
      async function searchShared(q) {
        const sp = window.__wsShareScope;
        if (!sp) return false;
        try {
          const qs = new URLSearchParams({ q, topic: sp.topic || '' });
          if (sp.project) qs.set('project', sp.project);
          const res = await fetch('/api/share/search?' + qs);
          if (!res.ok) return false;
          const data = await res.json();
          const hits = (data.results || []).map((r) => ({
            url: r.url + '?share=1&q=' + encodeURIComponent(q),
            title: r.title,
            meta: [r.type, r.status ? (statusText[r.status] || r.status) : ''].filter(Boolean).join(' · '),
            excerpt: hlSnippet(r.snippet, q),
          }));
          renderHits(hits);
          if (!hits.length) { box.innerHTML = '<div class="empty">本模块内无结果</div>'; box.hidden = false; }
          return true;
        } catch {
          return false;
        }
      }

      input?.addEventListener('input', debounce(async () => {
        const q = input.value.trim();
        if (!q) { box.hidden = true; box.innerHTML = ''; return; }
        if (await searchShared(q)) return;
        const engine = await ensurePagefind();
        if (engine) {
          const search = await engine.search(q);
          const top = search.results.slice(0, 8);
          const data = await Promise.all(top.map((r) => r.data()));
          renderHits(data.map((d) => ({
            url: d.url,
            title: (d.meta && d.meta.title) || q,
            meta: [d.meta && d.meta.topic, d.meta && d.meta.type && d.meta.type.toUpperCase(), d.meta && statusText[d.meta.status]].filter(Boolean).join(' · '),
            excerpt: d.excerpt || '',
          })));
          return;
        }
        const data = await ensureIndex();
        const hits = data
          .filter((d) => (d.title + ' ' + d.topic + ' ' + (d.summary || '') + ' ' + d.project + ' ' + d.type).toLowerCase().includes(q.toLowerCase()))
          .slice(0, 10);
        renderHits(hits.map((h) => ({
          url: h.url,
          title: h.title,
          meta: `${h.project} · ${h.topic} · ${statusText[h.status] || h.status}`,
          excerpt: '',
        })));
      }, 160));
      input?.addEventListener('keydown', (e) => {
        if (e.key !== 'Enter') return;
        const first = box.querySelector('a');
        if (first) { e.preventDefault(); location.href = first.getAttribute('href'); }
      });
      document.addEventListener('click', (e) => {
        if (box && !e.target.closest('.search-wrap')) box.hidden = true;
      });
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); input?.focus(); }
      });

      /* 搜索词定位与高亮（带上一处/下一处导航） */
      (function () {
        const params = new URLSearchParams(location.search);
        const q = (params.get('q') || '').trim();
        const container = document.querySelector('[data-pagefind-body]');
        if (!q || !container) return;

        const candidates = [q, ...q.split(/\s+/).filter(Boolean)];
        let marks = [];
        for (const term of candidates) {
          const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, {
            acceptNode(node) {
              if (!node.nodeValue || !node.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
              const p = node.parentElement;
              if (!p || p.closest('mark.search-hit')) return NodeFilter.FILTER_REJECT;
              const tag = p.tagName;
              if (tag === 'SCRIPT' || tag === 'STYLE') return NodeFilter.FILTER_REJECT;
              return NodeFilter.FILTER_ACCEPT;
            },
          });
          const nodes = [];
          while (walker.nextNode()) nodes.push(walker.currentNode);
          for (const node of nodes) {
            const text = node.nodeValue;
            const lowerText = text.toLowerCase();
            const lowerTerm = term.toLowerCase();
            let idx = lowerText.indexOf(lowerTerm);
            if (idx === -1) continue;
            const frag = document.createDocumentFragment();
            let last = 0;
            while (idx !== -1) {
              if (idx > last) frag.appendChild(document.createTextNode(text.slice(last, idx)));
              const mark = document.createElement('mark');
              mark.className = 'search-hit';
              mark.textContent = text.slice(idx, idx + term.length);
              frag.appendChild(mark);
              last = idx + term.length;
              idx = lowerText.indexOf(lowerTerm, last);
            }
            if (last < text.length) frag.appendChild(document.createTextNode(text.slice(last)));
            node.parentNode.replaceChild(frag, node);
          }
          marks = [...container.querySelectorAll('mark.search-hit')];
          if (marks.length) break;
        }
        if (!marks.length) return;

        let cur = 0;
        const nav = document.createElement('div');
        nav.className = 'search-nav';
        nav.innerHTML = '<span class="q">「' + q + '」</span><span class="count"></span>' +
          '<button data-dir="-1" title="上一处">↑</button><button data-dir="1" title="下一处">↓</button><button data-close="1" title="关闭高亮">×</button>';
        document.body.appendChild(nav);
        const countEl = nav.querySelector('.count');
        function go(i) {
          cur = (i + marks.length) % marks.length;
          marks.forEach((m, k) => m.classList.toggle('current', k === cur));
          const rect = marks[cur].getBoundingClientRect();
          window.scrollTo({ top: rect.top + window.scrollY - 96, behavior: 'smooth' });
          countEl.textContent = (cur + 1) + ' / ' + marks.length;
        }
        nav.addEventListener('click', (e) => {
          const t = e.target;
          if (t.dataset && t.dataset.close) {
            nav.remove();
            marks.forEach((m) => m.classList.remove('current'));
            return;
          }
          if (t.dataset && t.dataset.dir) go(cur + Number(t.dataset.dir));
        });
        go(0);
      })();

      /* 复制按钮（data-copy） */
      document.addEventListener('click', (e) => {
        const btn = e.target && e.target.closest ? e.target.closest('[data-copy]') : null;
        if (!btn) return;
        const text = btn.getAttribute('data-copy') || '';
        const label = btn.getAttribute('data-label') || btn.textContent;
        const done = () => {
          btn.textContent = '已复制 ✓';
          btn.classList.add('copied');
          setTimeout(() => { btn.textContent = label; btn.classList.remove('copied'); }, 1600);
        };
        const fallback = () => {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.top = '-1000px';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); done(); } catch (_) {}
          ta.remove();
        };
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(done).catch(fallback);
        } else {
          fallback();
        }
      });

      /* 代码块复制（右上角图标） */
      (() => {
        const blocks = document.querySelectorAll('.prose pre');
        if (!blocks.length) return;
        const ICON_COPY = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
        const ICON_DONE = '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>';
        const copyText = (text, done) => {
          const fallback = () => {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.top = '-1000px';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); done(); } catch (_) {}
            ta.remove();
          };
          if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(done).catch(fallback);
          } else {
            fallback();
          }
        };
        blocks.forEach((pre) => {
          const code = pre.querySelector('code');
          if (!code || !code.textContent.trim()) return;
          const wrap = document.createElement('div');
          wrap.className = 'code-wrap';
          pre.parentNode.insertBefore(wrap, pre);
          wrap.appendChild(pre);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'code-copy';
          btn.title = '复制代码';
          btn.setAttribute('aria-label', '复制代码');
          btn.setAttribute('data-pagefind-ignore', '');
          btn.innerHTML = ICON_COPY;
          btn.addEventListener('click', () => {
            copyText(code.innerText, () => {
              btn.innerHTML = ICON_DONE;
              btn.classList.add('copied');
              setTimeout(() => {
                btn.innerHTML = ICON_COPY;
                btn.classList.remove('copied');
              }, 1500);
            });
          });
          wrap.appendChild(btn);
        });
      })();

      /* 仅文档正文可复制，界面其他区域禁用 */
      document.addEventListener('copy', (e) => {
        const sel = document.getSelection();
        if (!sel || sel.isCollapsed) return;
        const node = sel.anchorNode;
        const el = node && (node.nodeType === 1 ? node : node.parentElement);
        if (el && (el.closest('.prose') || el.closest('input, textarea'))) return;
        e.preventDefault();
      });
    </script>
  </body>
</html>
